#cloud-config
hostname: "${hostname}"
fqdn: "srv.db.${hostname}.${domain_name}"
prefer_fqdn_over_hostname: true
bootcmd:
    - mkdir -p /home
    - mkdir -p /var/lib/postgresql
    - mkdir -p /var/lib/redis
    
disk_setup:
    /dev/sdb:
        table_type: gpt
        layout: true
fs_setup:
    - label: dbdata
      filesystem: ext4
      device: /dev/sdb1
      overwrite: false
mounts:
    - [ "LABEL=dbdata", "/var/lib/postgresql", "ext4", "defaults,nofail", "0", "2" ]
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
users:
  - name: j
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh-authorized-keys:
      - ${ssh_key_j}
  - name: ansible
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh-authorized-keys:
      - ${ansible_key}